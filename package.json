{
  "name": "@gg-utils/terminal-ui-kit",
  "version": "0.2.0",
  "type": "module",
  "description": "Reusable terminal UI primitives for classic readline, Ink, and OpenTUI command surfaces.",
  "exports": {
    "./cli-interactive": {
      "types": "./dist/cli-interactive/framework.d.ts",
      "default": "./dist/cli-interactive/framework.js"
    },
    "./ink/bridge-task": {
      "types": "./dist/ink/bridge-task.d.ts",
      "default": "./dist/ink/bridge-task.js"
    },
    "./ink/captured-output": {
      "types": "./dist/ink/captured-output.d.ts",
      "default": "./dist/ink/captured-output.js"
    },
    "./ink/chrome": {
      "types": "./dist/ink/chrome.d.ts",
      "default": "./dist/ink/chrome.js"
    },
    "./ink/command-preview": {
      "types": "./dist/ink/command-preview.d.ts",
      "default": "./dist/ink/command-preview.js"
    },
    "./ink/legend": {
      "types": "./dist/ink/legend.d.ts",
      "default": "./dist/ink/legend.js"
    },
    "./ink/status": {
      "types": "./dist/ink/status.d.ts",
      "default": "./dist/ink/status.js"
    },
    "./ink/use-stdout-dimensions": {
      "types": "./dist/ink/use-stdout-dimensions.d.ts",
      "default": "./dist/ink/use-stdout-dimensions.js"
    },
    "./opentui/create-renderer": {
      "types": "./dist/opentui/create-renderer.d.ts",
      "default": "./dist/opentui/create-renderer.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/**/*.unit.test.js\"",
    "check:dist": "sh scripts/check-dist.sh"
  },
  "dependencies": {
    "@opentui/core": "^0.1.90",
    "ink": "^6.8.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.2"
  },
  "main": "./dist/cli-interactive/framework.js",
  "types": "./dist/cli-interactive/framework.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/terminal-ui-kit.git"
  },
  "engines": {
    "node": ">=22.0.0 <27"
  }
}
